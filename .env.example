# Rozana — environment variables

# Where form submissions are forwarded (waitlist + contact).
# Create a form at https://formspree.io and paste its endpoint here, e.g.
# CONTACT_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
#
# If this is left blank, the /api/lead route logs submissions to the server
# console and still returns success, so the page works before it is wired up.
CONTACT_FORM_ENDPOINT=
